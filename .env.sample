NODE_ENV=development
PORT=5001
DATABASE_URL="postgresql://username:password@localhost:5432/fitness_gh_db?schema=public"

# JWT Configuration (generate random 32+ char strings for secrets)
JWT_ACCESS_SECRET="your-super-secret-access-token-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# SMTP (optional in dev — falls back to a mock/logging email service when unset)
SMTP_SERVER="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Vercel Blob storage token for uploads (optional in dev)
BLOB_READ_WRITE_TOKEN=""